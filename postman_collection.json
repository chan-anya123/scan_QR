{
  "info": {
    "name": "QR HTTP Server",
    "description": "Requests for the standalone qr_http_server.py app.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Ping",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/ping",
          "host": ["{{base_url}}"],
          "path": ["ping"]
        }
      }
    },
    {
      "name": "Read QR Code",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"retries\": 3,\n  \"retry_interval\": 0.2\n}"
        },
        "url": {
          "raw": "{{base_url}}/read",
          "host": ["{{base_url}}"],
          "path": ["read"]
        }
      }
    }
  ]
}
