[Unit]
Description=QR Code HTTP Server
After=multi-user.target

[Service]
Type=simple
# Adjust the path below to wherever you install the script
ExecStart=/usr/bin/python3 /opt/qr-http-server/qr_http_server.py --port 8080
Restart=on-failure
RestartSec=2
User=your_username
# Needed if your camera device requires video group permissions
SupplementaryGroups=video

[Install]
WantedBy=multi-user.target
